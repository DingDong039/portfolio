# Resend API Key for email functionality
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email address to receive contact form submissions
CONTACT_EMAIL=your_contact_email_here

# Cloudflare Turnstile — https://developers.cloudflare.com/turnstile/get-started/
# Public site key (safe for the browser; inlined into the client bundle at build time)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Secret key (server-only; must never reach the client bundle, logs, or API responses)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
# Comma-separated hostnames allowed to pass verification, e.g. localhost,your-domain.com
TURNSTILE_ALLOWED_HOSTNAMES=localhost
