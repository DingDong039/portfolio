{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "nextjs", "jsx-a11y", "promise", "import"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19.2"
    }
  },
  "ignorePatterns": ["node_modules", ".next", "out", "build", "next-env.d.ts"]
}
